{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PATH": "E:\\tools\\oss-cad-suite\\bin;E:\\tools\\oss-cad-suite\\lib;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "1 编译",
      "type": "shell",
      "command": "iverilog",
      "args": ["-g2012", "-o", "sim", "counter.v", "counter_tb.v"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "2 仿真",
      "type": "shell",
      "command": "vvp",
      "args": ["sim"],
      "dependsOn": "1 编译",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
